# Dependencies
node_modules/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test artifacts
coverage/
.nyc_output/

# OS metadata
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/
*.swp
*.swo

# Environment files (defense in depth — should never exist in this repo)
.env
.env.local
.env.*.local

# NOTE: keys/server-pubkey.pem IS committed to this repo on purpose.
# It is the Chameleon Labs license-server *public* key. Bundling it with the
# plugin is the entire point — every install verifies signed offline tokens
# against this exact bytes-for-bytes copy. It is not a secret. Do not add
# keys/ to this gitignore.
